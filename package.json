{
  "name": "@aiagenta2z/agtm",
  "version": "1.1.4",
  "description": "agtm: CLI Tool for AI Agent Management, Skills, Agent, MCP, API Registry, Benchmarks and Hints in AI Agent Marketplace\n",
  "main": "dist/agtm-cli.js",
  "type": "module",
  "bin": {
    "agtm": "dist/agtm-cli.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/agtm-cli.js', 0o755)\"",
    "test": "npm run build && node --loader ts-node/esm test/skills.spec.ts && node --loader ts-node/esm test/hints_parse.spec.ts && node --loader ts-node/esm test/skills_build.spec.ts"
  },
  "files": [
    "dist",
    "data",
    "docs",
    "README.md",
    "agent.json",
    "agent.yaml",
    "agent_api.json",
    "agent_api.yaml",
    "schema.json"
  ],
  "author": "deepnlp",
  "license": "ISC",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aiagenta2z/onekey-gateway": "^0.1.1",
    "axios": "^1.13.2",
    "commander": "^14.0.2",
    "js-yaml": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aiagenta2z/agtm"
  },
  "homepage": "https://www.deepnlp.org/store/ai-agent"
}
